            <CheatEntry>
              <ID>1807637717</ID>
              <Description>"改分数(获取的)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
-- ===== 用户配置区 =====
local targetPattern = "00 00 00 00 00 40 7F 40"  -- 特征码
local scanRadius = 1024                          -- 搜索半径
local checkAddress = "libiworld.dll+1B7A918"     -- 地图ID地址
local checkValue = 66711258790998                -- 地图ID
local newValue = 999999.0                        -- 要修改的新值

-- 需要匹配的双精度浮点数值（允许多个相同值）
local targetValues = {
    500.0,   -- KillCriminal (1次)
    150.0,   -- KillGood (1次)
    7.0,     -- GoodSurvivceScore (1次)
    100.0,   -- SavePeopleScore (1次)
    1.5,     -- WinMagnification (1次)
    300.0,   -- BaseCriminalScore (1次)
}
-- =====================

-- 检查地图ID
local addr = getAddress(checkAddress)
if addr == 0 or readQword(addr) ~= checkValue then
    return
end

-- 扫描特征码
local results = AOBScan(targetPattern)
if results == nil then
    return
end

local modifiedCount = 0

-- 遍历每个特征码位置
for i = 0, results.Count - 1 do
    local baseAddr = tonumber(results[i], 16)
    local startAddr = math.max(baseAddr - scanRadius, 0)
    local endAddr = baseAddr + scanRadius

    -- 创建需要匹配的数值副本（用于计数）
    local needToFind = {}
    for _, val in ipairs(targetValues) do
        needToFind[#needToFind + 1] = val
    end

    -- 记录需要修改的地址
    local addressesToModify = {}

    -- 搜索并记录匹配到的数值地址
    for searchAddr = startAddr, endAddr, 8 do
        local value = readDouble(searchAddr)
        if value then
            -- 查找并记录匹配的数值
            for j = #needToFind, 1, -1 do
                if math.abs(value - needToFind[j]) &lt; 0.001 then
                    addressesToModify[searchAddr] = true
                    table.remove(needToFind, j)
                    break
                end
            end
        end
    end

    -- 如果所有数值都找到了，进行修改
    if #needToFind == 0 then
        for addr, _ in pairs(addressesToModify) do
            writeDouble(addr, newValue)
            modifiedCount = modifiedCount + 1
        end
        print(string.format("特征码地址 0x%X: 已修改 %d 个数值为 %.0f", baseAddr, #targetValues, newValue))
    end
end

if modifiedCount &gt; 0 then
    print(string.format("修改完成，共修改 %d 个数值", modifiedCount))
end

results.destroy()

