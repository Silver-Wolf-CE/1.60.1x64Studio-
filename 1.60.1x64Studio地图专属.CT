</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1807689671</ID>
              <Description>"快速切枪卡无间隔射击"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
local targetPattern = "9A 99 99 99 99 99 F1 3F"
local scanRadius = 1024
local targetValues = {
    3.3
}
local matchedResults = {}
local results = AOBScan(targetPattern)
if results == nil then
    print("未找到特征码")
    return
end
for i = 0, results.Count - 1 do
    local baseAddr = tonumber(results[i], 16)
    local startAddr = math.max(baseAddr - scanRadius, 0)
    local endAddr = baseAddr + scanRadius
    local foundValues = {}
    local foundAddresses = {}

    for targetIdx, targetVal in ipairs(targetValues) do
        foundValues[targetIdx] = false
        foundAddresses[targetIdx] = nil
    end
    for searchAddr = startAddr, endAddr, 8 do
        local value = readDouble(searchAddr)
        if value then
            for targetIdx, targetVal in ipairs(targetValues) do
                if not foundValues[targetIdx] and math.abs(value - targetVal) &lt; 0.001 then
                    foundValues[targetIdx] = true
                    foundAddresses[targetIdx] = searchAddr
                    break
                end
            end
        end
    end
    local allFound = true
    for _, found in ipairs(foundValues) do
        if not found then
            allFound = false
            break
        end
    end
    if allFound then
        table.insert(matchedResults, {
            patternAddress = baseAddr,
            foundAddresses = foundAddresses,
            foundValues = targetValues
        })
    end
end

results.destroy()
if #matchedResults == 0 then
else
    for idx, match in ipairs(matchedResults) do
        for valIdx, addr in ipairs(match.foundAddresses) do
            if addr then
                local oldVal = readDouble(addr)
                writeDouble(addr, 0.0)
                local newVal = readDouble(addr)
           end
        end
        local patternAddr = match.patternAddress
        local oldPatternVal = readDouble(patternAddr)
        writeDouble(patternAddr, 0.0)
        local newPatternVal = readDouble(patternAddr)
   end
end
