              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
-- ===== 用户配置区 =====
local mainPattern = "?? ?? ?? ?? FF FF FF FF 00 00 00 00 00 00 08 40 00 00 00 00 00 00 08 40 00 00 00 00 00 00 08 40 ?? ?? ?? ?? FF FF FF FF"
local searchValue = 30000.0        -- 要搜索的数值
local newValue = 1000000.0          -- 要修改成的数值（改成1000000.0）
local scanRadius = 1024
local checkAddress = "libiworld.dll+1B7A918"    -- 需要检查的地图ID地址
local checkValue = 66711258790998                -- 需要匹配的地图ID
-- =====================

-- 首先检查地图ID
local addr = getAddress(checkAddress)
if addr == 0 then
    ShowMessage("开启失败：无法获取地图ID")
    return
end

local addrValue = readQword(addr)  -- 读取8字节整数
if addrValue ~= checkValue then
    -- 地图不匹配，显示提示信息
    ShowMessage("开启失败：您不在指定地图内\n请手动前往此地图:谁是狼人(地图ID:66711258790998)")
    return
end

-- 地图匹配，执行扫描
local mainResults = AOBScan(mainPattern)
if mainResults == nil then
    ShowMessage("开启失败：没有发现目标数据")
    return
end

local targetStartOffset = 8
local modified = false

for i = 0, mainResults.Count - 1 do
    local baseAddr = tonumber(mainResults[i], 16)
    modified = true

    -- 修改主特征码中的3个连续双精度浮点数为0.0
    for j = 0, 2 do
        writeDouble(baseAddr + targetStartOffset + (j * 8), 0.0)
    end

    -- 在当前地址附近搜索30000.0并修改为1000000.0
    local startAddr = baseAddr - scanRadius
    if startAddr &lt; 0 then startAddr = 0 end
    local endAddr = baseAddr + scanRadius

    for searchAddr = startAddr, endAddr, 8 do
        local val = readDouble(searchAddr)
        if val and val &gt; (searchValue - 0.001) and val &lt; (searchValue + 0.001) then
            writeDouble(searchAddr, newValue)
        end
    end
end

mainResults.destroy()

if modified then
    ShowMessage("开启成功")
else
    ShowMessage("开启失败：没有找到匹配的目标数值")
end

