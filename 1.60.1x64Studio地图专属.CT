        <CheatEntry>
          <ID>1807689610</ID>
          <Description>"谁是狼人(地图ID:66711258790998)"</Description>
          <Options moHideChildren="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1807637716</ID>
              <Description>"狼人快速普通攻击"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
-- ===== 用户配置区 =====
local pattern = "33 33 33 33 33 33 D3 3F 33 33 33 33 33 33 D3 3F 9A 99 99 99 99 99 D9 3F"
local scanRadius = 2048
local checkAddress = "libiworld.dll+1B7A918"    -- 需要检查的地图ID地址
local checkValue = 66711258790998                -- 需要匹配的地图ID
-- =====================

-- 首先检查地图ID
local addr = getAddress(checkAddress)
if addr == 0 then
    ShowMessage("开启失败：无法获取地图ID")
    return
end

local addrValue = readQword(addr)  -- 读取8字节整数
if addrValue ~= checkValue then
    -- 地图不匹配，显示提示信息
    ShowMessage("开启失败：您不在指定地图内\n请手动前往此地图:谁是狼人(地图ID:66711258790998)")
    return
end

-- 地图匹配，执行扫描
local results = AOBScan(pattern)
if results == nil then
    ShowMessage("开启失败：没有发现目标数据")
    return
end

local modified = false

for i = 0, results.Count - 1 do
    local baseAddr = tonumber(results[i], 16)
    modified = true

    -- 修改主特征码
    writeDouble(baseAddr, 0.0)
    writeDouble(baseAddr + 8, 0.0)
    writeDouble(baseAddr + 16, 0.0)

    -- 附近搜索连续的3个2.0
    local startAddr = baseAddr - scanRadius
    if startAddr &lt; 0 then startAddr = 0 end
    local endAddr = baseAddr + scanRadius

    for searchAddr = startAddr, endAddr - 16, 8 do
        local v1 = readDouble(searchAddr)
        local v2 = readDouble(searchAddr + 8)
        local v3 = readDouble(searchAddr + 16)

        if v1 and v2 and v3 then
            if math.abs(v1 - 2.0) &lt; 0.001 and
               math.abs(v2 - 2.0) &lt; 0.001 and
               math.abs(v3 - 2.0) &lt; 0.001 then

                writeDouble(searchAddr, 0.0)
                writeDouble(searchAddr + 8, 0.0)
                writeDouble(searchAddr + 16, 0.0)
            end
        end
    end
end

results.destroy()

if modified then
    ShowMessage("开启成功")
else
    ShowMessage("开启失败：没有找到匹配的目标数值")
end

