-- 新增配置
local targetPattern2 = "00 00 00 00 80 96 C9 40"  -- 15.0的特征码
local targetValue2 = 15.0                          -- 要匹配的数值2

local scanRadius = 1024                            -- 搜索半径
local checkAddress = "libiworld.dll+1B7A918"    -- 需要检查的地图ID地址
local checkValue = 66711258790998                -- 需要匹配的地图ID
-- =====================

-- 首先检查地图ID
local addr = getAddress(checkAddress)
if addr == 0 then
    ShowMessage("开启失败：无法获取地图ID")
    return
end

local addrValue = readQword(addr)  -- 读取8字节整数
if addrValue ~= checkValue then
    -- 地图不匹配，显示提示信息
    ShowMessage("开启失败：您不在指定地图内\n请手动前往此地图:谁是狼人(地图ID:66711258790998)")
    return
end

local modified = false

-- 处理第一个特征码和数值
local results1 = AOBScan(targetPattern1)
if results1 ~= nil then
    for i = 0, results1.Count - 1 do
        local baseAddr = tonumber(results1[i], 16)
        local startAddr = baseAddr - scanRadius
        if startAddr &lt; 0 then startAddr = 0 end
        local endAddr = baseAddr + scanRadius

        for searchAddr = startAddr, endAddr, 8 do
            local cdValue = readDouble(searchAddr)
            if cdValue and cdValue &gt; (targetValue1 - 0.001) and cdValue &lt; (targetValue1 + 0.001) then
                writeDouble(searchAddr, 0.1)
                modified = true
            end
        end
    end
    results1.destroy()
end

-- 处理新增的第二个特征码和数值
local results2 = AOBScan(targetPattern2)
if results2 ~= nil then
    for i = 0, results2.Count - 1 do
        local baseAddr = tonumber(results2[i], 16)
        local startAddr = baseAddr - scanRadius
        if startAddr &lt; 0 then startAddr = 0 end
        local endAddr = baseAddr + scanRadius

        for searchAddr = startAddr, endAddr, 8 do
            local cdValue = readDouble(searchAddr)
            if cdValue and cdValue &gt; (targetValue2 - 0.001) and cdValue &lt; (targetValue2 + 0.001) then
                writeDouble(searchAddr, 0.01)
                modified = true
            end
        end
    end
    results2.destroy()
end

if modified then
    ShowMessage("开启成功")
else
    ShowMessage("开启失败：没有找到匹配的目标数值")
end

