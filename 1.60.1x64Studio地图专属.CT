        <CheatEntry>
          <ID>1807637951</ID>
          <Description>"自己模型水平方向旋转(先获取人物信息)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$Lua}
if syntaxcheck then return end

[ENABLE]
horizontal_thread = createNativeThread(function (thread)
  thread.freeOnTerminate(false)
  thread.Name = 'horizontal_thread'

  -- 旋转参数配置
  local angle = 0               -- 初始角度(弧度)
  local angularSpeed = math.pi   -- 角速度(弧度/秒)，这里设为π rad/s(即180°/s)
  local updateInterval = 0.02    -- 更新间隔(秒)，即10毫秒

  -- 计算每次更新的角度增量
  local angleIncrement = angularSpeed * updateInterval

  -- 高精度等待函数(毫秒级)
  local function preciseWait(ms)
      local start = os.clock()
      while (os.clock() - start) * 1000 &lt; ms do end
  end

  while not thread.Terminated do
    -- 计算正弦和余弦值
    local value1 = math.cos(angle)
    local value2 = math.sin(angle)

    -- 写入内存
    writeFloat("[POS]+14", value1)
    writeFloat("[POS]+1C", value2)

    -- 按恒定角速度增加角度
    angle = angle + angleIncrement

    -- 角度归一化(保持在0-2π范围内)
    if angle &gt; 2 * math.pi then
      angle = angle - 2 * math.pi
    end

    -- 精确等待以保持恒定速度
    preciseWait(updateInterval * 300) -- 转换为毫秒
  end
end)

[DISABLE]
if horizontal_thread then -- kill thread
   horizontal_thread.terminate()
   horizontal_thread.waitfor()
   horizontal_thread.destroy()
   horizontal_thread=nil
end
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1807637952</ID>
          <Description>"自己模型垂直方向旋转(先获取人物信息)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$Lua}
if syntaxcheck then return end

[ENABLE]
-- 圆周倾斜参数配置
local amplitude = 0.7       -- 倾斜幅度
local angularSpeed = math.pi  -- 角速度(弧度/秒)，π=180度/秒
local updateInterval = 0.02   -- 更新间隔(秒)，20毫秒

-- 计算每次更新的角度增量
local angleIncrement = angularSpeed * updateInterval
local angle = 0  -- 初始角度

-- 高精度等待函数(毫秒级)
local function preciseWait(ms)
    local start = os.clock()
    while (os.clock() - start) * 1000 &lt; ms do end
end

oscillate_thread = createNativeThread(function (thread)
  thread.freeOnTerminate(false)
  thread.Name = 'oscillate_thread'

  while not thread.Terminated do
    -- 每次循环读取基址
    local baseAddr = readQword("POS")
    local addr1 = baseAddr + 0x10  -- 前后倒
    local addr2 = baseAddr + 0x18  -- 左右倒

    -- 计算圆周倾斜：前后倒用sin，左右倒用cos
    local forwardTilt = math.sin(angle) * amplitude
    local rightTilt = math.cos(angle) * amplitude

    -- 写入内存
    writeFloat(addr1, forwardTilt)
    writeFloat(addr2, rightTilt)

    -- 按恒定角速度增加角度
    angle = angle + angleIncrement

    -- 角度归一化(保持在0-2π范围内)
    if angle &gt; 2 * math.pi then
      angle = angle - 2 * math.pi
    end

    -- 精确等待以保持恒定速度
    preciseWait(updateInterval * 300)  -- 转换为毫秒
  end
end)

[DISABLE]
if oscillate_thread then
   oscillate_thread.terminate()
   oscillate_thread.waitfor()
   oscillate_thread.destroy()
   oscillate_thread = nil
end
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>1807689679</ID>
      <Description>"地图ID"</Description>
      <ShowAsSigned>0</ShowAsSigned>
      <VariableType>8 Bytes</VariableType>
      <Address>libiworld.dll+1B7A918</Address>
      <CheatEntries>
        <CheatEntry>
          <ID>1807637807</ID>
          <Description>"谁是枪神(地图ID:13904657468465)"</Description>
          <Options moHideChildren="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1807689491</ID>
              <Description>"无限子弹类"</Description>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1807637769</ID>
                  <Description>"谁是枪神刀快速攻击+超远距离+范围25格攻击(需要普通小刀)"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$Lua}
-- ===== 用户配置区 =====
local mainPattern1 = "00 00 00 00 00 72 A7 40"  -- 3001.0的双精度浮点特征码
local mainPattern2 = "00 00 00 00 00 74 A7 40"  -- 第二个特征码
local scanRadius = 4096                         -- 搜索半径
local checkAddress = "libiworld.dll+1B7A918"    -- 需要检查的地址
local checkValue = 13904657468465                -- 需要匹配的值
-- =====================

-- 首先检查指定地址的值
local addr = getAddress(checkAddress)
if addr == 0 then
    ShowMessage("无法获取地图ID")
    return
end

local addrValue = readQword(addr)  -- 读取8字节整数
if addrValue ~= checkValue then
    -- 地图不匹配，显示提示信息
    ShowMessage("您不在指定地图内,请手动前往此地图:\n谁是枪神(地图ID:13904657468465)")
    return
end

-- 值匹配，执行扫描
local mainResults1 = AOBScan(mainPattern1)
local mainResults2 = AOBScan(mainPattern2)

if mainResults1 == nil and mainResults2 == nil then
    ShowMessage("没有扫描到目标数据")
    return
end

local modified = false

-- 处理第一个特征码的结果
if mainResults1 then
    for i = 0, mainResults1.Count - 1 do
        local baseAddr = tonumber(mainResults1[i], 16)

        -- 在当前地址附近搜索目标数值
        local startAddr = baseAddr - scanRadius
        if startAddr &lt; 0 then startAddr = 0 end
        local endAddr = baseAddr + scanRadius

        for searchAddr = startAddr, endAddr, 8 do
            local val = readDouble(searchAddr)
            if val then
                -- 精确匹配25.0并改成2500.0
                if val == 25.0 then
                    writeDouble(searchAddr, 2500.0)
                    modified = true
                end

                -- 精确匹配36.0并改成10000.0
                if val == 36.0 then
                    writeDouble(searchAddr, 10000.0)
                    modified = true
                end

                -- 精确匹配1000.0并改成0.0
                if val == 1000.0 then
                    writeDouble(searchAddr, 0.0)
                    modified = true
                end

                -- 精确匹配150.0并改成100000.0
                if val == 150.0 then
                    writeDouble(searchAddr, 100000.0)
                    modified = true
                end
            end
        end
    end
    mainResults1.destroy()
end

-- 处理第二个特征码的结果
if mainResults2 then
    for i = 0, mainResults2.Count - 1 do
        local baseAddr = tonumber(mainResults2[i], 16)

        -- 在当前地址附近搜索目标数值
        local startAddr = baseAddr - scanRadius
        if startAddr &lt; 0 then startAddr = 0 end
        local endAddr = baseAddr + scanRadius

        for searchAddr = startAddr, endAddr, 8 do
            local val = readDouble(searchAddr)
            if val then
                -- 精确匹配25.0并改成2500.0
                if val == 25.0 then
                    writeDouble(searchAddr, 2500.0)
                    modified = true
                end

                -- 精确匹配36.0并改成10000.0
                if val == 36.0 then
                    writeDouble(searchAddr, 10000.0)
                    modified = true
                end

                -- 精确匹配1000.0并改成0.0
                if val == 1000.0 then
                    writeDouble(searchAddr, 0.0)
                    modified = true
                end

                -- 精确匹配150.0并改成100000.0
                if val == 150.0 then
                    writeDouble(searchAddr, 100000.0)
                    modified = true
                end
            end
        end
    end
    mainResults2.destroy()
end

if modified then
    ShowMessage("开启小刀暴力杀戮成功.\n目标数据:\n普通小刀攻击半径:2500(25格,参数最佳)\n普通小刀攻击距离:无限\n普通小刀工具冷却:0\n可能没效果,那就重进游戏再开一次")
else
    ShowMessage("开启功能失败,没有找到对应目标数据")
end

