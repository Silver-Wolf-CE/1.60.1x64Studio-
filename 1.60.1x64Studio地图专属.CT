              <Description>"小刀超高普通攻速"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
local targetPattern = "7B 14 AE 47 E1 7A C4 3F"
local scanRadius = 512
local modifyMap = {
    [0.7]   = 0.01,
    [0.06]  = 0.01,
    [0.16]  = 1.0,
    [0.12]  = 0.01,
    [200.0] = 20000.0,
}
local results = AOBScan(targetPattern)
if results == nil then
    print("未找到主特征码")
    return
end

local matchCount = 0
local modifiedCount = 0

for i = 0, results.Count - 1 do
    local baseAddr = tonumber(results[i], 16)
    local startAddr = math.max(baseAddr - scanRadius, 0)
    local endAddr = baseAddr + scanRadius

    local foundAny = false
    local oldPatternVal = readDouble(baseAddr)
    if oldPatternVal then
       writeDouble(baseAddr, 0.01)
        modifiedCount = modifiedCount + 1
        foundAny = true
    end
    for searchAddr = startAddr, endAddr, 8 do
        local value = readDouble(searchAddr)
        if value then
            for origVal, newVal in pairs(modifyMap) do
                if math.abs(value - origVal) &lt; 0.001 then
                   writeDouble(searchAddr, newVal)
                    modifiedCount = modifiedCount + 1
                    foundAny = true
                    break
                end
            end
        end
    end

    if foundAny then
        matchCount = matchCount + 1
    else
    end
end

